# egSYS JiraView — Environment (template)
# NUNCA versione o .env real (gitignore). Copie para .env e preencha.

# --- App ---
APP_ENV=dev
APP_PORT=8090
SECRET_KEY=change-me-32-char-random
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Jira (egSYS Atlassian) — backend-only, nunca expor ao frontend ---
JIRA_URL=https://egsys.atlassian.net
JIRA_USER=andre.prado@egsys.com.br
JIRA_TOKEN=REPLACE_WITH_ATLASSIAN_API_TOKEN
JIRA_PROJECTS=HDPMSC,SCPMH

# --- Dify (opcional, futuro CIES sync) ---
DIFY_API_URL=http://docker-api-1:5001/v1
DIFY_API_KEY=REPLACE
DIFY_DATASET_ID=REPLACE

# --- Segurança de recursos (espelho Docker) ---
MAX_MEM=512m
MAX_CPU=1.0
MAX_PIDS=150
